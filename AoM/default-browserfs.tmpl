    <script>
    (function () {
      var overlay = document.getElementById('aom-loading');
      if (!overlay) return;
      var bar = overlay.querySelector('.aom-progress');
      var fill = overlay.querySelector('.aom-progress__fill');
      var caption = overlay.querySelector('.aom-loading__caption');
      var sr = overlay.querySelector('.aom-sr-only');
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var phase = 'runtime';
      var watchdog = null;
      var WATCHDOG_MS = 75000; // CDN-failure timeout: 75s with no progress
      var COPY = {
        runtime: 'Downloading runtime',
        archive: 'Downloading game (approx 153 MB)',
        prepare: 'Preparing...',
        error: 'Connection problem - retrying',
        errorTerminal: "Couldn't reach the server. Check your connection, then reload."
      };

      function caption_(text) {
        if (caption.textContent === text) return;
        caption.style.opacity = '0';
        window.setTimeout(function () {
          caption.textContent = text;
          caption.style.opacity = '';
          if (sr) sr.textContent = text;
        }, 140);
      }
      function indeterminate() {
        bar.classList.add('is-indeterminate');
        bar.removeAttribute('aria-valuenow');
        bar.setAttribute('aria-valuetext', 'loading');
      }
      function determinate(pct) {
        bar.classList.remove('is-indeterminate');
        var v = Math.max(0, Math.min(100, Math.round(pct)));
        fill.style.width = v + '%';
        bar.setAttribute('aria-valuenow', String(v));
        bar.removeAttribute('aria-valuetext');
      }
      function clearWatchdog() {
        if (watchdog) { window.clearTimeout(watchdog); watchdog = null; }
      }
      function armWatchdog() {
        clearWatchdog();
        if (phase === 'error' || phase === 'errorTerminal') return;
        watchdog = window.setTimeout(function () {
          if (!window.__AOM_LOADED__) window.__AOM_LOADING.phase('error');
        }, WATCHDOG_MS);
      }

      window.__AOM_LOADING = {
        phase: function (name) {
          phase = name || 'runtime';
          if (phase === 'runtime') { caption_(COPY.runtime); armWatchdog(); return; }
          if (phase === 'errorTerminal') { overlay.classList.add('is-error'); indeterminate(); caption_(COPY.errorTerminal); clearWatchdog(); return; }
          if (phase === 'error') { overlay.classList.add('is-error'); indeterminate(); caption_(COPY.error); clearWatchdog(); return; }
          overlay.classList.remove('is-error');
          indeterminate();
          caption_(COPY[phase] || COPY.runtime);
          armWatchdog();
        },
        dismiss: function () {
          clearWatchdog();
          overlay.setAttribute('aria-busy', 'false');
          var finished = false;
          function done() {
            if (finished) return; finished = true;
            overlay.style.display = 'none';
            window.__AOM_LOADED__ = true;
          }
          overlay.classList.add('is-hiding');
          if (reduce) { window.setTimeout(done, 130); return; }
          overlay.addEventListener('transitionend', function (e) {
            if (e.propertyName === 'opacity') done();
          });
          window.setTimeout(done, 520);
        }
      };

      var status = document.getElementById('status');
      if (status) {
        var apply = function () {
          if (phase !== 'runtime') return;
          var m = (status.textContent || '').match(/\((\d+)\/(\d+)\)/);
          if (m && Number(m[2]) > 0) determinate((Number(m[1]) / Number(m[2])) * 100);
          else indeterminate();
          armWatchdog();
        };
        new MutationObserver(apply).observe(status, { childList: true, characterData: true, subtree: true });
        apply();
      }
      armWatchdog();
    })();
    </script>

