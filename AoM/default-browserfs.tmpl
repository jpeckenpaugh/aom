function show_infobox() {
    infobox.style.display = "block";

    // Measure box
    const w = infobox.offsetWidth;
    const h = infobox.offsetHeight;

    // Center in viewport
    const left = (window.innerWidth - w) / 2;
    const top = (window.innerHeight - h) / 2;

    infobox.style.left = left + "px";
    infobox.style.top = top + "px";
}

function fit_mush_canvas() {
    const canvas = document.getElementById("canvas");
    if (!canvas) {
        return;
    }
    const fb = mushFramebufferConfig();
    const aspect = fb.width / fb.height;
    const availableWidth = Math.max(1, window.innerWidth);
    const availableHeight = Math.max(1, window.innerHeight);
    let width = availableWidth;
    let height = Math.round(width / aspect);
    if (height > availableHeight) {
        height = availableHeight;
        width = Math.round(height * aspect);
    }
    const left = Math.round((availableWidth - width) / 2) + "px";
    const top = Math.round((availableHeight - height) / 2) + "px";
    const targetWidth = width + "px";
    const targetHeight = height + "px";
    if (
        canvas.style.width === targetWidth
        && canvas.style.height === targetHeight
        && canvas.style.left === left
        && canvas.style.top === top
    ) {
        return;
    }
    canvas.style.width = targetWidth;
    canvas.style.height = targetHeight;
    canvas.style.left = left;
    canvas.style.right = "auto";
    canvas.style.top = top;
    canvas.style.bottom = "auto";
}

globalThis.fit_mush_canvas = fit_mush_canvas;
window.addEventListener("resize", fit_mush_canvas);

function start_mush_canvas_fit_watchdog() {
    const canvas = document.getElementById("canvas");
    if (!canvas || canvas.__mushFitWatchdog) {
        return;
    }
    canvas.__mushFitWatchdog = true;
    const observer = new MutationObserver(() => requestAnimationFrame(fit_mush_canvas));
    observer.observe(canvas, { attributes: true, attributeFilter: ["style", "width", "height"] });
    const started = performance.now();
    const interval = setInterval(() => {
        fit_mush_canvas();
        if (performance.now() - started > 30000) {
            clearInterval(interval);
            observer.disconnect();
            canvas.__mushFitWatchdog = false;
        }
    }, 250);
}

function setup_mush_pointer_bridge() {
    const canvas = document.getElementById("canvas");
    if (!canvas || canvas.__mushPointerBridge) {
        return;
    }
    canvas.__mushPointerBridge = true;
    globalThis.__mushPointerClicks = globalThis.__mushPointerClicks || [];

    function framebufferPoint(event) {
        const rect = canvas.getBoundingClientRect();
        const fb = mushFramebufferConfig();
        const fbWidth = fb.width;
        const fbHeight = fb.height;
        const x = Math.round((event.clientX - rect.left) * fbWidth / Math.max(1, rect.width));
        const y = Math.round((event.clientY - rect.top) * fbHeight / Math.max(1, rect.height));
        return {
            x: Math.max(0, Math.min(fbWidth - 1, x)),
            y: Math.max(0, Math.min(fbHeight - 1, y)),
            button: event.button,
            target: event.target && event.target.id ? event.target.id : event.target.tagName,
            time: performance.now()
        };
    }

    function queuePointer(event, source) {
        canvas.focus();
        const point = framebufferPoint(event);
        point.source = source;
        globalThis.__mushPointerClicks.push(point);
        event.__mushPointerQueued = true;
        return point;
    }

    window.addEventListener("pointerdown", (event) => {
        const point = queuePointer(event, "window");
        console.log("mush window pointerdown", event.clientX, event.clientY, event.target && event.target.id, point);
    }, true);

    canvas.addEventListener("pointerdown", (event) => {
        canvas.focus();
        const point = event.__mushPointerQueued ? framebufferPoint(event) : queuePointer(event, "canvas");
        console.log("mush canvas pointerdown", point);
    }, true);
}

function mushFramebufferConfig() {
    let key = "standard";
    try {
        const params = new URLSearchParams(window.location.search);
        key = params.get("fb") || window.localStorage.getItem("mushFramebuffer") || key;
    } catch (error) {
        key = "standard";
    }
    if (key === "high") {
        return { key, width: 1280, height: 720 };
    }
    return { key: "standard", width: 960, height: 540 };
}

